# Paste into the Komodo Stack "Environment" field.
# [[NAME]] interpolates a Komodo Variable — no values live in this repo.
#
# Mark as Secret:  INFLUXDB_ADMIN_PASSWORD, GRAFANA_PASSWORD, UNIFI_PASS
# Plain Variables: UNIFI_USER, UNIFI_URL
#
# UNIFI_URL is a plain Variable rather than a literal only because it contains a
# LAN address and this repo is public (spec D5).
#
# Do NOT create Variables for INFLUXDB_DB or INFLUXDB_ADMIN_USER. Their value is
# `unpoller`, a substring of the image name ghcr.io/unpoller/unpoller — as a
# Komodo secret it would be redacted out of image and container names and break
# Komodo's state tracking (spec R6). They are literals in compose.yaml.
INFLUXDB_ADMIN_PASSWORD=[[INFLUXDB_ADMIN_PASSWORD]]
GRAFANA_PASSWORD=[[GRAFANA_PASSWORD]]
UNIFI_USER=[[UNIFI_USER]]
UNIFI_PASS=[[UNIFI_PASS]]
UNIFI_URL=[[UNIFI_URL]]
