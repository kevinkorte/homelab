# Paste into the Komodo Stack "Environment" field.
# [[NAME]] interpolates a Komodo Variable — no values live in this repo.
#
# TRACCAR_DB_PASSWORD must be marked Secret in Komodo. The same value is consumed
# by both services: it provisions the MySQL user and authenticates Traccar's JDBC
# connection, so they cannot drift apart.
TRACCAR_DB_PASSWORD=[[TRACCAR_DB_PASSWORD]]
