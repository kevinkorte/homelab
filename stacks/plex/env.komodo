# Paste into the Komodo Stack "Environment" field.
# [[NAME]] interpolates a Komodo Variable — no values live in this repo.
#
# PLEX_CLAIM_CODE is only read during initial server claiming and this server is
# already claimed, so an empty value is correct. Kept as a Variable so a rebuild
# from scratch has somewhere to put a fresh claim token.
TZ=[[TZ]]
PLEX_CLAIM_CODE=[[PLEX_CLAIM_CODE]]
