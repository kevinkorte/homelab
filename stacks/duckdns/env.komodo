# Paste into the Komodo Stack "Environment" field.
# [[NAME]] interpolates a Komodo Variable — no values live in this repo.
#
# Requires two Variables beyond TZ:
#   DUCKDNS_SUBDOMAIN  — plain Variable (not a credential, but kept out of the repo)
#   DUCKDNS_TOKEN      — MUST be marked Secret in Komodo
TZ=[[TZ]]
DUCKDNS_SUBDOMAIN=[[DUCKDNS_SUBDOMAIN]]
DUCKDNS_TOKEN=[[DUCKDNS_TOKEN]]
