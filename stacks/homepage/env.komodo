# Paste into the Komodo Stack "Environment" field.
# [[NAME]] interpolates a Komodo Variable — no values live in this repo.
#
# HOMEPAGE_ALLOWED_HOSTS is a Variable rather than a literal because it contains
# the server's LAN address, and this repo is public (see spec decision D5).
# Set its value in Komodo → Settings → Variables.
HOMEPAGE_ALLOWED_HOSTS=[[HOMEPAGE_ALLOWED_HOSTS]]
